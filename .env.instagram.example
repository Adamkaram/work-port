# Instagram API Tokens
# للحصول على الـ Access Token:
# 1. اذهب إلى https://developers.facebook.com/apps/
# 2. أنشئ App جديد واختر "Instagram Basic Display"
# 3. قم بإعداد OAuth redirect URIs
# 4. احصل على الـ Access Token

INSTAGRAM_DIAMOND_TOKEN=your_diamond_access_token_here
INSTAGRAM_MYMOMENTS_TOKEN=your_mymoments_access_token_here

# بدلاً من ذلك، يمكنك استخدام Apify Actor أو أي خدمة Instagram scraping
# للحصول على البيانات بدون API رسمي
